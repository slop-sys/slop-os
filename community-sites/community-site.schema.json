{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sloplabs.fun/schemas/community-site.schema.json",
  "title": "Microslop Explorer Community Site Submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "slug",
    "author",
    "description",
    "entry",
    "tags",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,40}$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 60
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9-]{3,40}$"
    },
    "author": {
      "type": "string",
      "minLength": 2,
      "maxLength": 40
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 280
    },
    "entry": {
      "type": "string",
      "pattern": "^(sites\\/[a-z0-9-]+\\/index\\.html)$"
    },
    "icon": {
      "type": "string",
      "pattern": "^(sites\\/[a-z0-9-]+\\/assets\\/[a-z0-9._-]+\\.(png|jpg|jpeg|gif|webp|svg))$"
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9-]{2,20}$"
      },
      "uniqueItems": true
    },
    "version": {
      "type": "string",
      "pattern": "^v?[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "license": {
      "type": "string",
      "maxLength": 40
    },
    "source": {
      "type": "string",
      "format": "uri",
      "maxLength": 200
    }
  }
}
