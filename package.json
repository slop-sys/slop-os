{
  "name": "slop-os",
  "version": "0.0.0",
  "private": true,
  "description": "SLOP-OS web interface",
  "keywords": [
    "framework",
    "nothing",
    "useless",
    "bot",
    "enterprise",
    "scalable",
    "production-ready",
    "typescript",
    "monorepo"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rotlabs/Rot-OS.git"
  },
  "license": "MIT",
  "author": "The useless bot Team",
  "scripts": {
    "build": "echo \"No build step configured\"",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage --passWithNoTests",
    "lint": "eslint docs/js scripts --ext .js,.mjs --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "clean": "rm -rf dist coverage",
    "dev": "npx http-server docs -p 8000 --cors"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=16.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.0"
}
